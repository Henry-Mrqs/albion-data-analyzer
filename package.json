{
  "name": "albion-market-analyzer",
  "version": "1.0.0",
  "description": "Collaborative Albion Online market analyzer tool",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "seed": "node server/seed.js",
    "client": "npm run --prefix client dev",
    "client:build": "npm run --prefix client build",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "npm install && npm install --prefix client --legacy-peer-deps"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.7"
  }
}
